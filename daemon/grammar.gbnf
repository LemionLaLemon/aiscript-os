# GBNF grammar for the tool-call protocol. Used as a fallback/validation aid
# if native tool calling misbehaves; the daemon primarily uses native tools.

root ::= tool-call

tool-call ::= "{" ws "\"tool\"" ws ":" ws string ws "," ws "\"args\"" ws ":" ws object "}"

object ::= "{" ws (pair (ws "," ws pair)*)? ws "}"
pair ::= string ws ":" ws value
value ::= string | number | "true" | "false" | "null" | array | object
array ::= "[" ws (value (ws "," ws value)*)? ws "]"

string ::= "\"" ([^"\\] | "\\" ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
number ::= "-"? [0-9]+ ("." [0-9]+)?
ws ::= [ \t\n]*
